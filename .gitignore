# -----------------------------------------------------------------------------
# .gitignore
# -----------------------------------------------------------------------------
# This file specifies intentionally untracked files that Git should ignore.
# It prevents temporary files, build artifacts, and sensitive data from being
# committed to the repository.
# -----------------------------------------------------------------------------

# Node.js Dependencies
# Ignore node_modules at the root and in any subdirectory (like frontend/)
node_modules/
**/node_modules/

# Build Output
# Ignore the production build artifacts from the frontend
build/frontend/
dist/
build/
frontend/node_modules/
deploy/pi/frontend/node_modules/
deploy/pi/frontend/dist/

# Python Artifacts
# Ignore compiled python files and cache directories
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
ENV/
env.bak/
venv.bak/

# Environment Variables
# Never commit .env files as they may contain secrets
.env
.env.local
.env.*.local

# System Files
# OS-generated files
.DS_Store
Thumbs.db

# IDE Configuration
# Ignore editor-specific settings
.vscode/
.idea/
*.swp
*.swo

# Application Data & Backups
# Ignore runtime data, logs, and backup directories
data/*
!config/category.csv
_backup/
deploy/pi/
*.log
*.sqlite
*.db
*.key
*.pem

# Temporary Files
tmp/
temp/
